{
  "info": {
    "_postman_id": "8e5da5ce-a86e-4f90-9129-a340f29979f0",
    "name": "Order Service Local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{orderBaseUrl}}"
    },
    {
      "key": "orderId",
      "value": "{{orderId}}"
    }
  ],
  "item": [
    {
      "name": "Get All Orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"]
        }
      }
    },
    {
      "name": "Get Order By Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "{{orderId}}"]
        }
      }
    },
    {
      "name": "Create Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    const id = pm.response.json().id;",
              "    pm.collectionVariables.set('orderId', id);",
              "    console.log('orderId saved: ' + id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Ivan Petrenko\",\n  \"productName\": \"Laptop\",\n  \"quantity\": 1,\n  \"totalPrice\": 45000.00,\n  \"status\": \"CREATED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders"]
        }
      }
    },
    {
      "name": "Update Order",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Ivan Petrenko\",\n  \"productName\": \"Laptop\",\n  \"quantity\": 2,\n  \"totalPrice\": 90000.00,\n  \"status\": \"PAID\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "{{orderId}}"]
        }
      }
    },
    {
      "name": "Request Payment (async → 202)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 202 Accepted', () => pm.response.to.have.status(202));",
              "pm.test('Order status is PAYMENT_REQUESTED', () => {",
              "    pm.expect(pm.response.json().status).to.eql('PAYMENT_REQUESTED');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paymentMethod\": \"CARD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}/payment",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "{{orderId}}", "payment"]
        }
      },
      "response": [
        {
          "name": "202 Accepted — payment request sent to RabbitMQ",
          "status": "Accepted",
          "code": 202,
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"id\": 1,\n  \"customerName\": \"Ivan Petrenko\",\n  \"productName\": \"Laptop\",\n  \"quantity\": 1,\n  \"totalPrice\": 45000.00,\n  \"status\": \"PAYMENT_REQUESTED\"\n}"
        }
      ]
    },
    {
      "name": "Get Order By Id (check payment result)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "{{orderId}}"]
        }
      },
      "response": [
        {
          "name": "200 OK — status PAID after RabbitMQ processing",
          "status": "OK",
          "code": 200,
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"id\": 1,\n  \"customerName\": \"Ivan Petrenko\",\n  \"productName\": \"Laptop\",\n  \"quantity\": 1,\n  \"totalPrice\": 45000.00,\n  \"status\": \"PAID\"\n}"
        }
      ]
    },
    {
      "name": "Delete Order",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "orders", "{{orderId}}"]
        }
      }
    }
  ]
}
